<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="30dp">

        <!-- Logo -->

        <ImageView
            android:id="@+id/ivForgotLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="GLA Bus Tracker Logo"
            android:src="@drawable/ic_bus" />

        <!-- App Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GLA BUS TRACKER"
            android:textColor="#B71C1C"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Page Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Forgot Password?"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Enter your Student ID to reset your password."
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Account Type Label -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="30dp"
            android:text="Account Type"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Account Type -->

        <AutoCompleteTextView
            android:id="@+id/actAccountType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:drawableEnd="@android:drawable/arrow_down_float"
            android:hint="Select Account Type"
            android:inputType="none"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:textColor="#222222"
            android:textColorHint="#888888"
            android:textSize="15sp" />

        <!-- Student ID Label -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="18dp"
            android:text="Student ID"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Student ID -->

        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter Student ID"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#222222"
            android:textColorHint="#888888"
            android:textSize="15sp" />

        <!-- Send OTP Button -->

        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#B71C1C"
            android:text="SEND OTP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Back To Login -->

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Back to Login"
            android:textColor="#B71C1C"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>